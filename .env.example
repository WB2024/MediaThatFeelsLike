# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key used to encrypt saved Radarr/Lidarr/Jellyfin/Navidrome credentials at rest
# in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Reddit access ---
# As of late 2025, Reddit's self-service developer app registration ("create app" at
# reddit.com/prefs/apps) rejects almost all new personal-use apps under its "Responsible
# Builder Policy" -- confirmed directly against this project. So the sync command's
# PRIMARY path is unauthenticated fetching from old.reddit.com, using a realistic
# browser User-Agent (not the polite "AppName/1.0 by u/username" convention -- that's
# for the OAuth API's own etiquette and would make unauthenticated requests stand out
# more, not less). See docs/ARCHITECTURE.md for the full reasoning.
REDDIT_FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# OPTIONAL: only needed if a Reddit developer app registration is ever approved. Leave
# blank otherwise -- the sync command works fine without these, just via the fetch path
# above instead. If set, the sync command should prefer these automatically.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MediaThatFeelsLike/0.1 by u/change-me

# --- Database ---
# Left unset, the app falls back to a local sqlite3 file (fine for a single-user
# homelab tool). Set this to point at Postgres/MySQL instead if preferred.
# DATABASE_URL=postgres://user:password@host:5432/mediathatfeelslike

# --- Media library integrations ---
# These can also be set (and changed) from the app's own Settings page once it exists;
# these env vars are only a convenience for first-run/local dev and for Docker deploys
# where you'd rather not touch the UI. The Settings page is the source of truth.
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
