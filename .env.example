# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key used to encrypt saved Radarr/Lidarr/Jellyfin/Navidrome credentials at rest
# in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Reddit access ---
# Which backend the sync uses (see docs/ARCHITECTURE.md → "Reddit access"):
#   auto    = PRAW if REDDIT_CLIENT_ID/SECRET are set, otherwise the Arctic Shift archive
#   archive = Arctic Shift (https://arctic-shift.photon-reddit.com), a public Reddit
#             archive with a JSON API: full posts incl. galleries, full comment trees
#             with real scores. The default in practice.
#   direct  = unauthenticated JSON from www.reddit.com. Reddit blocks this per-IP for
#             long stretches once it notices you (confirmed here); kept as an option.
#   praw    = the official OAuth API (registration effectively closed since Nov 2025).
REDDIT_BACKEND=auto
# Identify yourself politely to the archive (it is a volunteer-run service).
ARCHIVE_USER_AGENT=MediaThatFeelsLike/0.1 (self-hosted; +https://github.com/WB2024/MediaThatFeelsLike)
# Browser-like User-Agent used only by the "direct" backend.
REDDIT_FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:137.0) Gecko/20100101 Firefox/137.0

# OPTIONAL: only needed if a Reddit developer app registration is ever approved. Leave
# blank otherwise -- the sync command works fine without these, just via the fetch path
# above instead. If set, the sync command should prefer these automatically.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MediaThatFeelsLike/0.1 by u/change-me

# --- Database ---
# Left unset, the app falls back to a local sqlite3 file (fine for a single-user
# homelab tool). Set this to point at Postgres/MySQL instead if preferred.
# DATABASE_URL=postgres://user:password@host:5432/mediathatfeelslike

# --- Media library integrations ---
# These can also be set (and changed) from the app's own Settings page once it exists;
# these env vars are only a convenience for first-run/local dev and for Docker deploys
# where you'd rather not touch the UI. The Settings page is the source of truth.
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# slskd (Soulseek daemon) -- searches for a matching audio file and queues the download
# directly. Uses an API key, same as Radarr/Lidarr.
SLSKD_URL=
SLSKD_API_KEY=
# TheMovieDB -- embeds a movie recommendation's official trailer on the vibe page
# instead of only linking out to a YouTube search. Free account at themoviedb.org ->
# Settings -> API -> "API Read Access Token" (a long token starting "eyJ...", not the
# shorter v3 "API Key" next to it). No URL to set; the host is fixed.
TMDB_API_KEY=
# Last.fm -- listener/play counts, tags, bios, similar artists and top tracks on a music
# recommendation's own page. Free key at last.fm/api/account/create. Host is fixed.
# (MusicBrainz is used alongside it and needs no key at all.)
LASTFM_API_KEY=

# Where cached post images live. Leave unset to use a "media" subfolder of DATA_DIR
# (or of ./data in Docker). Cached images are comfortably the largest and
# fastest-growing thing this app stores, so this can point at different, larger
# storage than the sqlite DB -- e.g. a network-attached/NFS drive shared with the rest
# of the media library. Reads/writes will be slower than local disk, but for a cache
# that's rarely written and read at browsing speed, not streaming speed, that's a fine
# trade for a lot more headroom. In Docker, also add a matching volume mount in
# compose.yaml (see its comments) -- this variable alone doesn't move anything, it just
# tells Django where to look.
MEDIA_DATA_DIR=

# Sync stops caching new images (with a warning in the log) once free disk space under
# MEDIA_DATA_DIR (or DATA_DIR, if that's unset) drops below this many GB -- a deep
# backfill on these high-volume subreddits can genuinely fill a shared homelab disk if
# left unchecked. Listings/comments keep working regardless (they're KB-scale DB rows,
# not the disk-heavy part of the pipeline).
MIN_FREE_DISK_GB=2.0
