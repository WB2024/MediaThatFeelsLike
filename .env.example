# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key used to encrypt saved Radarr/Lidarr/Jellyfin/Navidrome credentials at rest
# in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Reddit access ---
# Which backend the sync uses (see docs/ARCHITECTURE.md → "Reddit access"):
#   auto    = PRAW if REDDIT_CLIENT_ID/SECRET are set, otherwise the Arctic Shift archive
#   archive = Arctic Shift (https://arctic-shift.photon-reddit.com), a public Reddit
#             archive with a JSON API: full posts incl. galleries, full comment trees
#             with real scores. The default in practice.
#   direct  = unauthenticated JSON from www.reddit.com. Reddit blocks this per-IP for
#             long stretches once it notices you (confirmed here); kept as an option.
#   praw    = the official OAuth API (registration effectively closed since Nov 2025).
REDDIT_BACKEND=auto
# Identify yourself politely to the archive (it is a volunteer-run service).
ARCHIVE_USER_AGENT=MediaThatFeelsLike/0.1 (self-hosted; +https://github.com/WB2024/MediaThatFeelsLike)
# Browser-like User-Agent used only by the "direct" backend.
REDDIT_FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:137.0) Gecko/20100101 Firefox/137.0

# OPTIONAL: only needed if a Reddit developer app registration is ever approved. Leave
# blank otherwise -- the sync command works fine without these, just via the fetch path
# above instead. If set, the sync command should prefer these automatically.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MediaThatFeelsLike/0.1 by u/change-me

# --- Database ---
# Left unset, the app falls back to a local sqlite3 file (fine for a single-user
# homelab tool). Set this to point at Postgres/MySQL instead if preferred.
# DATABASE_URL=postgres://user:password@host:5432/mediathatfeelslike

# --- Media library integrations ---
# These can also be set (and changed) from the app's own Settings page once it exists;
# these env vars are only a convenience for first-run/local dev and for Docker deploys
# where you'd rather not touch the UI. The Settings page is the source of truth.
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# slskd (Soulseek daemon) -- searches for a matching audio file and queues the download
# directly. Uses an API key, same as Radarr/Lidarr.
SLSKD_URL=
SLSKD_API_KEY=
